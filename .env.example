# Public client values only. Never expose SUPABASE_SERVICE_ROLE_KEY here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional, client-visible Google key for campus autocomplete.
# For web, restrict browser origins. For production native apps, proxy the
# request through a server/Edge Function; direct REST keys cannot stay secret.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
