{
  "expo": {
    "name": "StrathFind",
    "slug": "strathfind",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "strathfind",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.strathfind.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FA1747",
        "foregroundImage": "./assets/brand/adaptive-foreground.png"
      },
      "package": "app.strathfind.mobile",
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "single",
      "favicon": "./assets/brand/favicon.png",
      "name": "StrathFind",
      "shortName": "StrathFind",
      "themeColor": "#FA1747",
      "backgroundColor": "#F7F4F1"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FA1747",
          "image": "./assets/brand/splash.png",
          "imageWidth": 176
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow StrathFind to choose a photo for a lost or found item report.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
